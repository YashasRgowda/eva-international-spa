rules_version = '2';

// Anyone can read the website content; only the spa's admin account can change it.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "evaspa.db@gmail.com";
    }

    // Brand, main banner and contact details
    match /site/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Massages and treatments
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Room gallery photos
    match /photos/{photoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
